# ─────────────────────────────────────────────────
# Portfolio Contact Server — Environment Variables
# ─────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ─────────────────────────────────────────────────

# Server
SERVER_PORT=4000

# ─────────────────────────────────────────────────
# SMTP Configuration (for sending contact emails)
# ─────────────────────────────────────────────────
# Common SMTP providers:
#
# Gmail (use App Password — requires 2FA enabled):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=yourname@gmail.com
#   SMTP_PASSWORD=your-16-char-app-password
#
# Outlook / Hotmail:
#   SMTP_HOST=smtp-mail.outlook.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#
# SendGrid:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=apikey
#   SMTP_PASSWORD=SG.xxxxx
#
# Mailgun:
#   SMTP_HOST=smtp.mailgun.org
#   SMTP_PORT=587
#   SMTP_SECURE=false

SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_smtp_password

# ─────────────────────────────────────────────────
# Optional: Override the "From" email address
# ─────────────────────────────────────────────────
# If not set, falls back to SMTP_USER
# SMTP_FROM=portfolio@yourdomain.com

# ─────────────────────────────────────────────────
# Where to receive contact form submissions
# ─────────────────────────────────────────────────
CONTACT_EMAIL=your_email@example.com

